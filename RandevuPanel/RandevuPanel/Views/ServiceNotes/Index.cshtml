@model IEnumerable<RandevuPanel.Models.ServiceNote>
@{
    ViewData["Title"] = "Notlar";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0 section-title"><i class="bi bi-journal-text text-cyan me-2"></i>Notlar</h5>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>Yeni Not
    </a>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="bi bi-journal-x fs-1 d-block mb-3" style="color:var(--text-muted)"></i>
            Henüz not eklenmemiş.
        </div>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var note in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card h-100">
                    @if (!string.IsNullOrEmpty(note.PhotoPath))
                    {
                        <img src="@note.PhotoPath" class="card-img-top" style="height:180px;object-fit:cover;" alt="Ünite Fotoğrafı" />
                    }
                    <div class="card-body d-flex flex-column gap-2">
                        @if (note.OperationNotPossible)
                        {
                            <span class="badge bg-danger align-self-start fs-6 mb-1">
                                <i class="bi bi-x-circle me-1"></i>İşlem Yapılamıyor
                            </span>
                        }
                        else
                        {
                            @if (!string.IsNullOrEmpty(note.VehicleBrand) || !string.IsNullOrEmpty(note.VehicleModel))
                            {
                                <div class="fw-semibold text-cyan">
                                    <i class="bi bi-car-front me-1"></i>
                                    @note.VehicleBrand @note.VehicleModel
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(note.PossibleOperations))
                            {
                                <div class="small text-muted">
                                    <i class="bi bi-tools me-1"></i>
                                    <span style="white-space:pre-line">@note.PossibleOperations</span>
                                </div>
                            }
                            @if (note.TotalCost.HasValue)
                            {
                                <div class="small">
                                    <i class="bi bi-currency-dollar me-1 text-cyan"></i>
                                    <strong>@note.TotalCost.Value.ToString("N2") ₺</strong>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(note.OperationNote))
                            {
                                <div class="small text-muted border-top pt-2 mt-1" style="white-space:pre-line">
                                    <i class="bi bi-sticky me-1"></i>@note.OperationNote
                                </div>
                            }
                        }
                        <div class="text-muted" style="font-size:0.72rem;">
                            @note.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </div>
                    </div>
                    <div class="card-footer d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@note.Id" class="btn btn-sm btn-outline-secondary">
                            <i class="bi bi-pencil me-1"></i>Düzenle
                        </a>
                        <form asp-action="Delete" asp-route-id="@note.Id" method="post"
                              onsubmit="return confirm('Bu notu silmek istediğinize emin misiniz?')">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash me-1"></i>Sil
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}
