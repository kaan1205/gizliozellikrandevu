@model RandevuPanel.ViewModels.ServiceNoteViewModel
@{
    ViewData["Title"] = "Notu Düzenle";
}

<div class="card" style="max-width:720px;">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-journal-pen text-cyan"></i>
        <span class="section-title">Notu Düzenle</span>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div class="row g-3 mb-4">
                <div class="col-md-5">
                    <label class="form-label">Araç Marka</label>
                    <input asp-for="VehicleBrand" class="form-control" placeholder="BMW, Renault..." />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Araç Model</label>
                    <input asp-for="VehicleModel" class="form-control" placeholder="320i, Clio..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Yıl</label>
                    <input asp-for="VehicleYear" type="number" class="form-control" placeholder="2018" min="1900" max="2100" />
                </div>
                <div class="col-12">
                    <label class="form-label">Ünite Fotoğrafı</label>
                    @if (!string.IsNullOrEmpty(Model.ExistingPhotoPath))
                    {
                        <div class="mb-2">
                            <img src="@Model.ExistingPhotoPath" style="height:120px;object-fit:cover;border-radius:6px;" alt="Mevcut Fotoğraf" />
                            <div class="text-muted small mt-1">Yeni fotoğraf seçilirse mevcut değiştirilir.</div>
                        </div>
                    }
                    <input asp-for="Photo" type="file" class="form-control" accept="image/*" />
                    <input type="hidden" asp-for="ExistingPhotoPath" />
                </div>
            </div>

            <!-- İşlem Yapılamıyor -->
            <div class="form-check mb-4 p-3 rounded" style="background:rgba(239,68,68,0.08);border:1px solid rgba(239,68,68,0.25);">
                <input class="form-check-input" type="checkbox" asp-for="OperationNotPossible" id="notPossibleCheck" />
                <label class="form-check-label fw-semibold text-danger" for="notPossibleCheck">
                    <i class="bi bi-x-circle me-1"></i>İşlem Yapılamıyor
                </label>
                <div class="text-muted small mt-1">Bu kutuyu işaretlerseniz aşağıdaki alanlar devre dışı kalır.</div>
            </div>

            <div id="fieldsArea" class="row g-3">
                <div class="col-12">
                    <label class="form-label">Yapılabilecek İşlemler</label>
                    <textarea asp-for="PossibleOperations" class="form-control" rows="3"
                              placeholder="İşlem listesi..."></textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label">Toplam Maliyet (₺)</label>
                    <input asp-for="TotalCost" type="number" step="0.01" class="form-control" placeholder="0.00" />
                </div>
                <div class="col-12">
                    <label class="form-label">İşleme Ait Not</label>
                    <textarea asp-for="OperationNote" class="form-control" rows="3"
                              placeholder="Notlar..."></textarea>
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i>Güncelle
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    (function () {
        var chk = document.getElementById('notPossibleCheck');
        var area = document.getElementById('fieldsArea');

        function toggle() {
            var inputs = area.querySelectorAll('input, textarea, select');
            inputs.forEach(function (el) {
                el.disabled = chk.checked;
            });
            area.style.opacity = chk.checked ? '0.4' : '1';
        }

        chk.addEventListener('change', toggle);
        toggle();
    })();
</script>
}
