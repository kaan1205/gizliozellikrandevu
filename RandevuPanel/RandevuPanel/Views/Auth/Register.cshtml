@model RandevuPanel.ViewModels.Auth.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
    Layout = "_LoginLayout";
}

<div class="auth-page-bg">
    <div class="auth-card card" style="max-width:500px;">
        <div class="card-body">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus auth-logo-icon"></i>
                <h4 class="auth-title mt-3">Yeni Hesap Oluştur</h4>
                <p class="auth-subtitle">Sisteme katılın</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <asp-validation-summary asp-validation-summary="All" class="mb-0"></asp-validation-summary>
                </div>
            }

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" placeholder="Adınız" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" placeholder="Soyadınız" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" placeholder="ornek@eposta.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" placeholder="••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" placeholder="••••••" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <div class="col-12 mt-2">
                        <button type="submit" class="btn auth-btn w-100">
                            <i class="bi bi-person-check me-2"></i>Kayıt Ol
                        </button>
                    </div>
                </div>
            </form>

            <hr class="auth-divider" />
            <div class="auth-footer-link text-center">
                Zaten hesabınız var mı?
                <a asp-controller="Auth" asp-action="Login">Giriş Yapın</a>
            </div>
        </div>
    </div>
</div>
