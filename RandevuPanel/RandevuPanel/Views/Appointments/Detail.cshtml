@model RandevuPanel.Models.Appointment
@using RandevuPanel.Models
@{
    ViewData["Title"] = "Randevu Detayı";
    var (badgeClass, statusLabel) = Model.Status switch
    {
        AppointmentStatus.Bekliyor => ("primary", "Bekliyor"),
        AppointmentStatus.Geldi => ("warning", "Geldi"),
        AppointmentStatus.Tamamlandi => ("success", "Tamamlandı"),
        AppointmentStatus.IptalEdildi => ("danger", "İptal Edildi"),
        _ => ("secondary", Model.Status.ToString())
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h5 class="page-title mb-1">
            <i class="bi bi-card-list me-2 text-cyan"></i>
            Randevu <span class="text-cyan">#@Model.Id</span>
        </h5>
        <span class="badge bg-@badgeClass">@statusLabel</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-1"></i>Düzenle
        </a>
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-inline"
              onsubmit="return confirm('Bu randevuyu silmek istediğinize emin misiniz?')">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-danger btn-sm">
                <i class="bi bi-trash me-1"></i>Sil
            </button>
        </form>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Geri
        </a>
    </div>
</div>

<div class="row g-3">
    <!-- Randevu Bilgileri -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-calendar me-2 text-cyan"></i>
                <span class="section-title">Randevu Bilgileri</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0" style="--bs-gap: 0.75rem;">
                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Tarih</dt>
                    <dd class="col-sm-7 fw-semibold text-cyan">@Model.AppointmentDate.ToString("dd MMMM yyyy")</dd>

                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Saat</dt>
                    <dd class="col-sm-7 fw-semibold text-cyan">@Model.AppointmentTime.ToString("HH:mm")</dd>

                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Yapılacak İşlem</dt>
                    <dd class="col-sm-7">@Model.ProcessDescription</dd>

                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Durum</dt>
                    <dd class="col-sm-7"><span class="badge bg-@badgeClass">@statusLabel</span></dd>

                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Oluşturulma</dt>
                    <dd class="col-sm-7" style="color:var(--text-muted); font-size:0.82rem;">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</dd>

                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Son Güncelleme</dt>
                    <dd class="col-sm-7" style="color:var(--text-muted); font-size:0.82rem;">@Model.UpdatedAt.ToString("dd.MM.yyyy HH:mm")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Müşteri Bilgileri -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-person me-2 text-cyan"></i>
                <span class="section-title">Müşteri Bilgileri</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Ad Soyad</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.CustomerName</dd>

                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Telefon</dt>
                    <dd class="col-sm-7">
                        <a href="tel:@Model.CustomerPhone" style="color:var(--accent-cyan);">@Model.CustomerPhone</a>
                    </dd>

                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Platform</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-secondary">
                            @(Model.ContactPlatform switch
                            {
                                ContactPlatform.Telefon => "📞 Telefon",
                                ContactPlatform.WhatsApp => "💬 WhatsApp",
                                ContactPlatform.Facebook => "🔵 Facebook",
                                ContactPlatform.Instagram => "📸 Instagram",
                                ContactPlatform.Google => "🔍 Google",
                                ContactPlatform.Diger => "➕ Diğer",
                                _ => Model.ContactPlatform.ToString()
                            })
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Araç Bilgileri -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-car-front me-2 text-cyan"></i>
                <span class="section-title">Araç Bilgileri</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Marka</dt>
                    <dd class="col-sm-7 fw-semibold">@Model.VehicleBrand</dd>

                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Model</dt>
                    <dd class="col-sm-7">@Model.VehicleModel</dd>

                    <dt class="col-sm-5" style="color:var(--text-muted); font-size:0.82rem;">Şase No</dt>
                    <dd class="col-sm-7" style="color:@(string.IsNullOrWhiteSpace(Model.VinNumber) ? "var(--text-muted)" : "inherit");">
                        @(string.IsNullOrWhiteSpace(Model.VinNumber) ? "—" : Model.VinNumber)
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <i class="bi bi-journal-text me-2 text-cyan"></i>
                    <span class="section-title">Ek Notlar</span>
                </div>
                <div class="card-body">
                    <p class="mb-0" style="color:var(--text-dim); line-height:1.7;">@Model.Notes</p>
                </div>
            </div>
        </div>
    }
</div>
