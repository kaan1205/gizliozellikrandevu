@model RandevuPanel.ViewModels.Appointments.AppointmentListViewModel
@using RandevuPanel.Models
@{
    ViewData["Title"] = "Randevular";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="page-title mb-0">
        <i class="bi bi-list-ul me-2 text-cyan"></i>Randevular
    </h5>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse"
                data-bs-target="#filterCollapse">
            <i class="bi bi-funnel me-1"></i>Filtrele
        </button>
        <a asp-action="Calendar" class="btn btn-outline-primary btn-sm">
            <i class="bi bi-calendar3 me-1"></i>Takvim
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Yeni Randevu
        </a>
    </div>
</div>

<!-- Filtre Paneli -->
<div class="collapse @(IsFilterActive(Model.Filter) ? "show" : "")" id="filterCollapse">
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-2">
                    <div class="col-md-3 col-6">
                        <label class="form-label">Başlangıç Tarihi</label>
                        <input type="date" name="DateFrom" class="form-control form-control-sm"
                               value="@Model.Filter.DateFrom?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label">Bitiş Tarihi</label>
                        <input type="date" name="DateTo" class="form-control form-control-sm"
                               value="@Model.Filter.DateTo?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label">Araç Markası</label>
                        <input type="text" name="VehicleBrand" class="form-control form-control-sm"
                               value="@Model.Filter.VehicleBrand" placeholder="BMW, Renault..." />
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label">Müşteri Adı</label>
                        <input type="text" name="CustomerName" class="form-control form-control-sm"
                               value="@Model.Filter.CustomerName" placeholder="Ad Soyad" />
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label">Telefon</label>
                        <input type="text" name="CustomerPhone" class="form-control form-control-sm"
                               value="@Model.Filter.CustomerPhone" placeholder="05xx..." />
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label">Platform</label>
                        <select name="ContactPlatform" class="form-select form-select-sm">
                            <option value="">Tümü</option>
                            @foreach (var p in Enum.GetValues<ContactPlatform>())
                            {
                                <option value="@((int)p)" selected="@(Model.Filter.ContactPlatform == p)">@p.ToString()</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 col-6">
                        <label class="form-label">Durum</label>
                        <select name="Status" class="form-select form-select-sm">
                            <option value="">Tümü</option>
                            @foreach (var s in Enum.GetValues<AppointmentStatus>())
                            {
                                <option value="@((int)s)" selected="@(Model.Filter.Status == s)">@StatusLabel(s)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3 col-6 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-search me-1"></i>Ara
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm w-100">Temizle</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Tablo -->
<div class="card">
    <div class="card-body p-0">
        @if (!Model.Appointments.Any())
        {
            <div class="text-center py-5" style="color:var(--text-muted);">
                <i class="bi bi-calendar-x fs-1 d-block mb-2" style="opacity:0.3;"></i>
                Randevu bulunamadı.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark-header align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Tarih / Saat</th>
                            <th>Müşteri</th>
                            <th>Araç</th>
                            <th>İşlem</th>
                            <th>Platform</th>
                            <th>Durum</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.Appointments)
                        {
                            <tr>
                                <td>
                                    <div class="fw-semibold text-cyan">@a.AppointmentDate.ToString("dd.MM.yyyy")</div>
                                    <div style="color:var(--text-muted); font-size:0.8rem;">@a.AppointmentTime.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div>@a.CustomerName</div>
                                    <div style="color:var(--text-muted); font-size:0.8rem;">@a.CustomerPhone</div>
                                </td>
                                <td>@a.VehicleBrand @a.VehicleModel</td>
                                <td>
                                    <span title="@a.ProcessDescription">
                                        @(a.ProcessDescription.Length > 30 ? a.ProcessDescription[..30] + "…" : a.ProcessDescription)
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@PlatformLabel(a.ContactPlatform)</span>
                                </td>
                                <td>
                                    <select class="status-select" data-id="@a.Id">
                                        @foreach (var s in Enum.GetValues<AppointmentStatus>())
                                        {
                                            <option value="@((int)s)" selected="@(a.Status == s)">@StatusLabel(s)</option>
                                        }
                                    </select>
                                </td>
                                <td class="text-end">
                                    <a asp-action="Detail" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-secondary" title="Detay">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-primary" title="Düzenle">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@a.Id" method="post" class="d-inline"
                                          onsubmit="return confirm('Bu randevuyu silmek istediğinize emin misiniz?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <form id="antiforgery-form">@Html.AntiForgeryToken()</form>
    <script>
        document.querySelectorAll('.status-select').forEach(function (sel) {
            sel.addEventListener('change', function () {
                const id = this.dataset.id;
                const status = this.value;
                const token = document.querySelector('#antiforgery-form input[name="__RequestVerificationToken"]')?.value || '';
                fetch('/Appointments/UpdateStatus', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `id=${id}&status=${status}`
                }).then(r => r.json()).then(data => {
                    if (!data.success) alert('Durum güncellenemedi.');
                });
            });
        });
    </script>
}

@functions {
    bool IsFilterActive(RandevuPanel.ViewModels.Appointments.AppointmentFilterViewModel f)
        => f.DateFrom.HasValue || f.DateTo.HasValue || !string.IsNullOrWhiteSpace(f.VehicleBrand)
        || !string.IsNullOrWhiteSpace(f.CustomerName) || !string.IsNullOrWhiteSpace(f.CustomerPhone)
        || f.ContactPlatform.HasValue || f.Status.HasValue;

    string StatusLabel(AppointmentStatus s) => s switch
    {
        AppointmentStatus.Bekliyor => "Bekliyor",
        AppointmentStatus.Geldi => "Geldi",
        AppointmentStatus.Tamamlandi => "Tamamlandı",
        AppointmentStatus.IptalEdildi => "İptal Edildi",
        _ => s.ToString()
    };

    string PlatformLabel(ContactPlatform p) => p switch
    {
        ContactPlatform.Diger => "Diğer",
        ContactPlatform.Telefon => "Telefon",
        _ => p.ToString()
    };
}
