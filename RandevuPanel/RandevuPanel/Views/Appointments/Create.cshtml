@model RandevuPanel.ViewModels.Appointments.AppointmentCreateViewModel
@using RandevuPanel.Models
@{
    ViewData["Title"] = "Randevu Ekle";
}

<div class="card" style="max-width: 860px;">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-plus-circle text-cyan"></i>
        <span class="section-title">Yeni Randevu Ekle</span>
    </div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="AppointmentDate" class="form-label"></label>
                    <input asp-for="AppointmentDate" type="date" class="form-control" />
                    <span asp-validation-for="AppointmentDate" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AppointmentTime" class="form-label"></label>
                    <input asp-for="AppointmentTime" type="time" class="form-control" />
                    <span asp-validation-for="AppointmentTime" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VehicleBrand" class="form-label"></label>
                    <input asp-for="VehicleBrand" class="form-control" placeholder="BMW, Renault, Ford..." />
                    <span asp-validation-for="VehicleBrand" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VehicleModel" class="form-label"></label>
                    <input asp-for="VehicleModel" class="form-control" placeholder="320i, Clio, Focus..." />
                    <span asp-validation-for="VehicleModel" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="VinNumber" class="form-label"></label>
                    <input asp-for="VinNumber" class="form-control" placeholder="17 haneli şase no (opsiyonel)" maxlength="17" />
                    <span asp-validation-for="VinNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProcessDescription" class="form-label"></label>
                    <input asp-for="ProcessDescription" class="form-control" placeholder="Yağ değişimi, fren bakımı..." />
                    <span asp-validation-for="ProcessDescription" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerName" class="form-label"></label>
                    <input asp-for="CustomerName" class="form-control" placeholder="Ad Soyad" />
                    <span asp-validation-for="CustomerName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CustomerPhone" class="form-label"></label>
                    <input asp-for="CustomerPhone" type="tel" class="form-control" placeholder="05xx xxx xx xx" />
                    <span asp-validation-for="CustomerPhone" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ContactPlatform" class="form-label"></label>
                    <select asp-for="ContactPlatform" class="form-select">
                        @foreach (var p in Enum.GetValues<ContactPlatform>())
                        {
                            <option value="@((int)p)">
                                @(p switch
                                {
                                    ContactPlatform.Telefon => "📞 Telefon",
                                    ContactPlatform.WhatsApp => "💬 WhatsApp",
                                    ContactPlatform.Facebook => "🔵 Facebook",
                                    ContactPlatform.Instagram => "📸 Instagram",
                                    ContactPlatform.Google => "🔍 Google",
                                    ContactPlatform.Diger => "➕ Diğer",
                                    _ => p.ToString()
                                })
                            </option>
                        }
                    </select>
                    <span asp-validation-for="ContactPlatform" class="text-danger small"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Ek notlar..."></textarea>
                </div>
                <div class="col-12 d-flex gap-2 pt-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg me-1"></i>Randevuyu Kaydet
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                </div>
            </div>
        </form>
    </div>
</div>
