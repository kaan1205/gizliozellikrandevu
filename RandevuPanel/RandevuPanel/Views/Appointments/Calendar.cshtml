@{
    ViewData["Title"] = "Takvim";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0">
        <i class="bi bi-calendar3 me-2 text-primary"></i>Takvim Görünümü
    </h5>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list-ul me-1"></i>Liste
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Randevu Ekle
        </a>
    </div>
</div>

<!-- Renk Açıklamaları -->
<div class="d-flex gap-3 mb-3 flex-wrap">
    <span class="badge bg-primary px-3 py-2">Bekliyor</span>
    <span class="badge bg-warning text-dark px-3 py-2">Geldi</span>
    <span class="badge bg-success px-3 py-2">Tamamlandı</span>
    <span class="badge bg-danger px-3 py-2">İptal Edildi</span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div id="calendar"></div>
    </div>
</div>

<!-- Gün Detay Modal -->
<div class="modal fade" id="dayModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="dayModalTitle">Randevular</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="dayModalBody">
                <div class="text-center text-muted py-3">Yükleniyor...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/locales/tr.global.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('calendar');
            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'tr',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listWeek'
                },
                events: function (fetchInfo, successCallback, failureCallback) {
                    fetch(`/Appointments/CalendarEvents?start=${fetchInfo.startStr}&end=${fetchInfo.endStr}`)
                        .then(r => r.json())
                        .then(data => successCallback(data))
                        .catch(() => failureCallback());
                },
                eventClick: function (info) {
                    window.location.href = `/Appointments/Detail/${info.event.extendedProps.appointmentId}`;
                },
                dateClick: function (info) {
                    const date = info.dateStr;
                    const dateLabel = new Date(date).toLocaleDateString('tr-TR', { day: 'numeric', month: 'long', year: 'numeric' });
                    document.getElementById('dayModalTitle').textContent = dateLabel + ' Randevuları';

                    const events = calendar.getEvents().filter(e => {
                        const eDate = e.start ? e.start.toISOString().split('T')[0] : null;
                        return eDate === date;
                    });

                    let html = '';
                    if (events.length === 0) {
                        html = '<p class="text-muted text-center">Bu güne ait randevu yok.</p>';
                    } else {
                        html = '<div class="list-group">';
                        events.forEach(e => {
                            const time = e.start ? e.start.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) : '';
                            html += `<a href="/Appointments/Detail/${e.extendedProps.appointmentId}"
                                        class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="fw-semibold">${time}</span> — ${e.title}
                                    <br><small class="text-muted">${e.extendedProps.process}</small>
                                </div>
                                <span class="badge" style="background-color:${e.backgroundColor}">${e.extendedProps.status}</span>
                            </a>`;
                        });
                        html += '</div>';
                    }
                    document.getElementById('dayModalBody').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('dayModal')).show();
                },
                height: 'auto',
                businessHours: true,
                nowIndicator: true
            });
            calendar.render();
        });
    </script>
}
