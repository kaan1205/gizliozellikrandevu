@{
    ViewData["Title"] = "Takvim";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="page-title mb-0">
        <i class="bi bi-calendar3 me-2 text-cyan"></i>Takvim Görünümü
    </h5>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-list-ul me-1"></i>Liste
        </a>
        <a asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Randevu Ekle
        </a>
    </div>
</div>

<!-- Renk Açıklamaları -->
<div class="d-flex gap-2 mb-3 flex-wrap">
    <span class="badge bg-primary px-3 py-2">Bekliyor</span>
    <span class="badge bg-warning px-3 py-2">Geldi</span>
    <span class="badge bg-success px-3 py-2">Tamamlandı</span>
    <span class="badge bg-danger px-3 py-2">İptal Edildi</span>
</div>

<div class="card">
    <div class="card-body p-3">
        <div id="calendar"></div>
    </div>
</div>

<!-- Gün Detay Modal -->
<div class="modal fade" id="dayModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-cyan" id="dayModalTitle">Randevular</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="dayModalBody">
                <div class="text-center py-3" style="color:var(--text-muted);">Yükleniyor...</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <form id="af-form">@Html.AntiForgeryToken()</form>
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/locales/tr.global.min.js"></script>
    <style>
        /* FullCalendar extra dark overrides */
        .fc-theme-standard .fc-scrollgrid { border-color: rgba(0,212,255,0.1) !important; }
        .fc .fc-daygrid-day-frame { min-height: 80px; }
        .fc .fc-event { border-radius: 6px !important; font-size: 0.78rem !important; border: none !important; padding: 2px 6px !important; }
        .fc .fc-event:hover { filter: brightness(1.15); cursor: pointer; }
        .fc-popover { background: #0d1220 !important; border: 1px solid rgba(0,212,255,0.2) !important; border-radius: 10px !important; }
        .fc-popover-header { background: rgba(0,212,255,0.06) !important; color: var(--text-primary) !important; }
    </style>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const calendarEl = document.getElementById('calendar');
            const calendar = new FullCalendar.Calendar(calendarEl, {
                initialView: 'dayGridMonth',
                locale: 'tr',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,listWeek'
                },
                events: function (fetchInfo, successCallback, failureCallback) {
                    fetch(`/Appointments/CalendarEvents?start=${fetchInfo.startStr}&end=${fetchInfo.endStr}`)
                        .then(r => r.json())
                        .then(data => successCallback(data))
                        .catch(() => failureCallback());
                },
                eventClick: function (info) {
                    window.location.href = `/Appointments/Detail/${info.event.extendedProps.appointmentId}`;
                },
                dateClick: function (info) {
                    const date = info.dateStr;
                    const dateLabel = new Date(date + 'T00:00:00').toLocaleDateString('tr-TR', {
                        day: 'numeric', month: 'long', year: 'numeric'
                    });
                    document.getElementById('dayModalTitle').textContent = dateLabel + ' — Randevular';

                    const events = calendar.getEvents().filter(e => {
                        const eDate = e.start ? e.start.toISOString().split('T')[0] : null;
                        return eDate === date;
                    });

                    let html = '';
                    if (events.length === 0) {
                        html = '<p class="text-center py-3" style="color:var(--text-muted);">Bu güne ait randevu yok.</p>';
                    } else {
                        html = '<div class="list-group">';
                        events.forEach(e => {
                            const time = e.start ? e.start.toLocaleTimeString('tr-TR', { hour: '2-digit', minute: '2-digit' }) : '';
                            const aid = e.extendedProps.appointmentId;
                            const statusColors = { 'Bekliyor': '#0d6efd', 'Geldi': '#ffc107', 'Tamamlandi': '#198754', 'IptalEdildi': '#dc3545' };
                            const statusLabels = { 'Bekliyor': 'Bekliyor', 'Geldi': 'Geldi', 'Tamamlandi': 'Tamamlandı', 'IptalEdildi': 'İptal Edildi' };
                            const cur = e.extendedProps.status;
                            const btnHtml = Object.entries(statusLabels).map(([k, v]) =>
                                `<button onclick="updateStatus(${aid},'${k}',this)" class="btn btn-xs px-2 py-0 me-1"
                                    style="font-size:0.72rem;border:1px solid ${statusColors[k]}40;
                                    background:${k===cur ? statusColors[k]+'30' : 'transparent'};
                                    color:${statusColors[k]};border-radius:4px">${v}</button>`
                            ).join('');
                            html += `<div class="list-group-item d-flex justify-content-between align-items-start gap-2 py-2">
                                <div>
                                    <a href="/Appointments/Detail/${aid}" class="fw-bold text-cyan text-decoration-none">${time}</a>
                                    <span class="mx-1" style="color:var(--text-muted)">—</span>
                                    ${e.title.replace(time + ' - ', '')}
                                    <br><small style="color:var(--text-muted)">${e.extendedProps.process}</small>
                                    <div class="mt-1">${btnHtml}</div>
                                </div>
                            </div>`;
                        });
                        html += '</div>';
                    }
                    document.getElementById('dayModalBody').innerHTML = html;
                    new bootstrap.Modal(document.getElementById('dayModal')).show();
                },
                height: 'auto',
                nowIndicator: true,
                businessHours: true
            });
            calendar.render();
        });

        function updateStatus(id, status, btn) {
            const token = document.querySelector('#af-form input[name="__RequestVerificationToken"]')?.value || '';
            fetch('/Appointments/UpdateStatus', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
                body: `id=${id}&status=${status}`
            }).then(r => r.json()).then(data => {
                if (data.success) {
                    btn.closest('.list-group-item').querySelectorAll('button').forEach(b => b.style.background = 'transparent');
                    btn.style.background = btn.style.color.replace(')', ',0.2)').replace('rgb', 'rgba');
                } else { alert('Güncellenemedi.'); }
            });
        }
    </script>
}
