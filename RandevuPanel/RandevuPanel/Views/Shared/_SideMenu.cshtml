@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
}

<div id="sidebar-wrapper">
    <div class="sidebar-heading">
        <i class="bi bi-hexagon-half me-2"></i>RANDEVU<span style="opacity:.5;font-weight:300;">PANEL</span>
    </div>
    <nav class="sidebar-nav">
        <div class="section-title px-4 mb-2" style="font-size:0.68rem; margin-top:0.5rem;">MENÜ</div>

        <a class="sidebar-link @(controller == "Dashboard" ? "active" : "")"
           asp-controller="Dashboard" asp-action="Index">
            <i class="bi bi-speedometer2"></i>
            <span>Ana Sayfa</span>
        </a>
        <a class="sidebar-link @(controller == "Appointments" && action == "Create" ? "active" : "")"
           asp-controller="Appointments" asp-action="Create">
            <i class="bi bi-plus-circle"></i>
            <span>Randevu Ekle</span>
        </a>
        <a class="sidebar-link @(controller == "Appointments" && action == "Index" ? "active" : "")"
           asp-controller="Appointments" asp-action="Index">
            <i class="bi bi-list-ul"></i>
            <span>Randevular</span>
        </a>
        <a class="sidebar-link @(controller == "Appointments" && action == "Calendar" ? "active" : "")"
           asp-controller="Appointments" asp-action="Calendar">
            <i class="bi bi-calendar3"></i>
            <span>Takvim</span>
        </a>

        <hr class="sidebar-divider mt-3" />

        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-block">
            @Html.AntiForgeryToken()
            <button type="submit" class="sidebar-link logout-link w-100 text-start border-0 bg-transparent">
                <i class="bi bi-box-arrow-right"></i>
                <span>Çıkış Yap</span>
            </button>
        </form>
    </nav>

    <!-- Sidebar Footer -->
    <div class="px-4 pb-3" style="border-top:1px solid rgba(0,212,255,0.08); padding-top:0.75rem;">
        <div style="font-size:0.68rem; color:var(--text-muted); letter-spacing:0.05em;">
            <i class="bi bi-circle-fill me-1" style="color:#10b981; font-size:0.5rem;"></i>SİSTEM AKTİF
        </div>
    </div>
</div>
