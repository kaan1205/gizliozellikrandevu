@model RandevuPanel.ViewModels.Dashboard.DashboardViewModel
@using RandevuPanel.Models
@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Stat Kartları -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-primary bg-opacity-10 p-3">
                    <i class="bi bi-calendar-day text-primary fs-4"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold text-primary">@Model.TodayCount</div>
                    <div class="text-muted small">Bugünkü Randevu</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-warning bg-opacity-10 p-3">
                    <i class="bi bi-clock-history text-warning fs-4"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold text-warning">@Model.UpcomingCount</div>
                    <div class="text-muted small">Yaklaşan (7 Gün)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-success bg-opacity-10 p-3">
                    <i class="bi bi-check-circle text-success fs-4"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold text-success">@Model.CompletedCount</div>
                    <div class="text-muted small">Tamamlanan</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="rounded-3 bg-danger bg-opacity-10 p-3">
                    <i class="bi bi-x-circle text-danger fs-4"></i>
                </div>
                <div>
                    <div class="fs-2 fw-bold text-danger">@Model.CancelledCount</div>
                    <div class="text-muted small">İptal Edilen</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bugün Uyarı Kutusu -->
@if (Model.TodayCount == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>Bugün için planlanmış randevu bulunmuyor.
    </div>
}
else
{
    <div class="alert alert-primary">
        <i class="bi bi-calendar-check me-2"></i>
        <strong>Bugün @Model.TodayCount randevunuz var.</strong>
    </div>
}

<!-- Yaklaşan Randevular -->
@if (Model.ApproachingAppointments.Any())
{
    <div class="card border-danger border-2 mb-4">
        <div class="card-header bg-danger text-white fw-semibold">
            <i class="bi bi-alarm me-2"></i>1 Saatten Az Kalan Randevular
        </div>
        <div class="list-group list-group-flush">
            @foreach (var a in Model.ApproachingAppointments)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-semibold">@a.AppointmentTime.ToString("HH:mm")</span>
                        — @a.VehicleBrand @a.VehicleModel
                        <span class="text-muted">(@a.CustomerName)</span>
                    </div>
                    <a asp-controller="Appointments" asp-action="Detail" asp-route-id="@a.Id"
                       class="btn btn-sm btn-outline-danger">Detay</a>
                </div>
            }
        </div>
    </div>
}

<!-- Bugünkü Randevular -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold d-flex justify-content-between align-items-center">
        <span><i class="bi bi-list-check me-2 text-primary"></i>Bugünkü Randevular</span>
        <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Randevu Ekle
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.TodayAppointments.Any())
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                Bugün randevu yok.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Saat</th>
                            <th>Müşteri</th>
                            <th>Araç</th>
                            <th>İşlem</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.TodayAppointments)
                        {
                            <tr>
                                <td class="fw-semibold">@a.AppointmentTime.ToString("HH:mm")</td>
                                <td>
                                    @a.CustomerName
                                    <br /><span class="text-muted small">@a.CustomerPhone</span>
                                </td>
                                <td>@a.VehicleBrand @a.VehicleModel</td>
                                <td>@a.ProcessDescription</td>
                                <td>
                                    @{
                                        var (badgeClass, statusLabel) = a.Status switch
                                        {
                                            RandevuPanel.Models.AppointmentStatus.Bekliyor => ("primary", "Bekliyor"),
                                            RandevuPanel.Models.AppointmentStatus.Geldi => ("warning", "Geldi"),
                                            RandevuPanel.Models.AppointmentStatus.Tamamlandi => ("success", "Tamamlandı"),
                                            RandevuPanel.Models.AppointmentStatus.IptalEdildi => ("danger", "İptal"),
                                            _ => ("secondary", "?")
                                        };
                                    }
                                    <span class="badge bg-@badgeClass">@statusLabel</span>
                                </td>
                                <td>
                                    <a asp-controller="Appointments" asp-action="Detail" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
