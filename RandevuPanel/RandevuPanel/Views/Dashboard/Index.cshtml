@model RandevuPanel.ViewModels.Dashboard.DashboardViewModel
@using RandevuPanel.Models
@{
    ViewData["Title"] = "Ana Sayfa";
}

<!-- Stat Kartları -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card-cyan h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon-cyan">
                    <i class="bi bi-calendar-day text-cyan fs-4"></i>
                </div>
                <div>
                    <div class="stat-number text-cyan">@Model.TodayCount</div>
                    <div class="stat-label">Bugünkü Randevu</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card-yellow h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon-yellow">
                    <i class="bi bi-clock-history fs-4" style="color:var(--accent-yellow);"></i>
                </div>
                <div>
                    <div class="stat-number" style="color:var(--accent-yellow);">@Model.UpcomingCount</div>
                    <div class="stat-label">Yaklaşan (7 Gün)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card-green h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon-green">
                    <i class="bi bi-check-circle fs-4" style="color:var(--accent-green);"></i>
                </div>
                <div>
                    <div class="stat-number" style="color:var(--accent-green);">@Model.CompletedCount</div>
                    <div class="stat-label">Tamamlanan</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card-red h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="stat-icon-red">
                    <i class="bi bi-x-circle fs-4" style="color:var(--accent-red);"></i>
                </div>
                <div>
                    <div class="stat-number" style="color:var(--accent-red);">@Model.CancelledCount</div>
                    <div class="stat-label">İptal Edilen</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bugün Uyarı Kutusu -->
@if (Model.TodayCount == 0)
{
    <div class="alert alert-info mb-4">
        <i class="bi bi-info-circle me-2"></i>Bugün için planlanmış randevu bulunmuyor.
    </div>
}
else
{
    <div class="alert alert-primary mb-4">
        <i class="bi bi-calendar-check me-2"></i>
        <strong>Bugün @Model.TodayCount randevunuz var.</strong>
    </div>
}

<!-- Yaklaşan Randevular -->
@if (Model.ApproachingAppointments.Any())
{
    <div class="card mb-4" style="border-color: rgba(239,68,68,0.4) !important;">
        <div class="card-header d-flex align-items-center gap-2" style="border-color: rgba(239,68,68,0.25) !important;">
            <i class="bi bi-alarm" style="color:var(--accent-red); filter:drop-shadow(0 0 5px var(--accent-red));"></i>
            <span style="color:var(--accent-red); font-size:0.82rem; letter-spacing:0.06em; font-weight:600; text-transform:uppercase;">
                1 Saatten Az Kalan
            </span>
        </div>
        <div class="list-group list-group-flush">
            @foreach (var a in Model.ApproachingAppointments)
            {
                <div class="list-group-item d-flex justify-content-between align-items-center">
                    <div>
                        <span class="fw-bold text-cyan">@a.AppointmentTime.ToString("HH:mm")</span>
                        <span class="mx-2" style="color:var(--text-muted);">—</span>
                        <span>@a.VehicleBrand @a.VehicleModel</span>
                        <span class="ms-2" style="color:var(--text-muted);">(@a.CustomerName)</span>
                    </div>
                    <a asp-controller="Appointments" asp-action="Detail" asp-route-id="@a.Id"
                       class="btn btn-sm btn-outline-danger">Detay</a>
                </div>
            }
        </div>
    </div>
}

<!-- Bugünkü Randevular -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="section-title">
            <i class="bi bi-list-check me-2 text-cyan"></i>Bugünkü Randevular
        </span>
        <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg me-1"></i>Randevu Ekle
        </a>
    </div>
    <div class="card-body p-0">
        @if (!Model.TodayAppointments.Any())
        {
            <div class="text-center py-5" style="color:var(--text-muted);">
                <i class="bi bi-calendar-x fs-1 d-block mb-2" style="opacity:0.3;"></i>
                Bugün randevu yok.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-dark-header mb-0">
                    <thead>
                        <tr>
                            <th>Saat</th>
                            <th>Müşteri</th>
                            <th>Araç</th>
                            <th>İşlem</th>
                            <th>Durum</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Model.TodayAppointments)
                        {
                            <tr>
                                <td class="fw-bold text-cyan">@a.AppointmentTime.ToString("HH:mm")</td>
                                <td>
                                    <div>@a.CustomerName</div>
                                    <div style="color:var(--text-muted); font-size:0.8rem;">@a.CustomerPhone</div>
                                </td>
                                <td>@a.VehicleBrand @a.VehicleModel</td>
                                <td>@a.ProcessDescription</td>
                                <td>
                                    @{
                                        var (badgeClass, statusLabel) = a.Status switch
                                        {
                                            AppointmentStatus.Bekliyor => ("primary", "Bekliyor"),
                                            AppointmentStatus.Geldi => ("warning", "Geldi"),
                                            AppointmentStatus.Tamamlandi => ("success", "Tamamlandı"),
                                            AppointmentStatus.IptalEdildi => ("danger", "İptal"),
                                            _ => ("secondary", "?")
                                        };
                                    }
                                    <span class="badge bg-@badgeClass">@statusLabel</span>
                                </td>
                                <td>
                                    <a asp-controller="Appointments" asp-action="Detail" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
